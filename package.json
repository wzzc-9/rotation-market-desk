{
  "name": "rotation-market-desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "history:download": "node scripts/download-history.cjs",
    "backtest": "node scripts/backtest.cjs",
    "optimize:rotation": "node scripts/optimize-rotation.cjs",
    "history:asset:download": "node scripts/download-asset-rotation-history.cjs",
    "backtest:asset": "node scripts/backtest-asset-rotation.cjs",
    "optimize:asset": "node scripts/optimize-asset-rotation.cjs",
    "history:dual:download": "node scripts/download-dual-etf-history.cjs",
    "backtest:dual": "node scripts/backtest-dual-etf.cjs"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "fastify": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
