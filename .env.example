# 复制本文件为 .env.local 后填写。该文件包含密钥和数据库密码，不要提交到 Git。

# 服务地址。默认可直接用于本机和 Docker 部署。
HOST=0.0.0.0
PORT=3001
# 允许访问后端的前端地址；多个地址使用英文逗号分隔。同源部署可留空。
CORS_ORIGINS=

# MySQL 5.7+ 数据库。必须填写可用的连接信息。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rotation_market_desk
DB_PASSWORD=replace_me
DB_NAME=rotation_market_desk
# 使用云数据库 SSL 时设为 1；普通连接保持 0。
DB_SSL=0

# 个股策略日线数据源：tushare（默认）或 hithink。只填写当前选中数据源的密钥即可。
STOCK_DAILY_DATA_SOURCE=tushare
# Tushare Token；STOCK_DAILY_DATA_SOURCE=tushare 时必填。
TUSHARE_TOKEN=
# 同花顺金融数据服务 Key；STOCK_DAILY_DATA_SOURCE=hithink 时必填。
HITHINK_FINANCE_API_KEY=
# 同花顺数据包增量更新间隔，单位小时。首次使用会下载全市场完整日线缓存。
HITHINK_DAILY_K_REFRESH_HOURS=6

# 收盘后自动计算：1 为开启，0 为关闭。所有时间均使用北京时间。
AUTO_CALCULATION_ENABLED=1
# 每日任务开始时间。个股和日度 ETF 每个交易日执行；周度 ETF 仅周五执行。
AUTO_CALCULATION_TIME=15:15
